# Unreal Engine project files to ignore
Binaries/
DerivedDataCache/
Intermediate/
Saved/
.vs/
*.VC.db
*.VC.opendb

# Build/IDE specific
*.sln
*.suo
*.xcodeproj
*.xcworkspace
*.idea/
*.DS_Store

# Local build configs
*.user
*.userprefs

# Crash/backup files
*.dmp
*.pdb
*.log
*.sdf
*.opensdf
*.cache
*.db

# Generated project files (will be regenerated by UE)
*.ipr
*.iws

# Ignore Rider/JetBrains files
.idea/
*.iml

# Auto-generated config backups
Config/DefaultEditor.ini
Config/DefaultEditorPerProjectUserSettings.ini

# Ignore temp autosave
*_autosave.*

# OPTIONAL: Ignore plugin binaries if using 3rd-party plugins
Plugins/*/Binaries/
Plugins/*/Intermediate/

# Keep important folders
!Config/
!Content/
!Source/
!Plugins/**/Source/
!*.uproject